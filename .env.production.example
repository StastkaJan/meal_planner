# Copy to .env.production, replace every placeholder, and restrict it to the deploy user.
DOMAIN=meals.example.com

# Use an URL-safe random password, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-value
DATABASE_URL=postgresql://mealplan:replace-with-the-same-random-value@db:5432/mealplan

GRAFANA_ADMIN_USER=replace-with-non-default-user
GRAFANA_ADMIN_PASSWORD=replace-with-random-value

RESTIC_REPOSITORY=s3:s3.example.com/meal-plan-backups
RESTIC_PASSWORD=replace-with-random-value
AWS_ACCESS_KEY_ID=replace-with-provider-key
AWS_SECRET_ACCESS_KEY=replace-with-provider-secret
AWS_DEFAULT_REGION=eu-central-1
ALERT_WEBHOOK_URL_FILE=./secrets/alert-webhook-url

LOG_LEVEL=info

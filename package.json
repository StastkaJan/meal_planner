{
  "name": "meal-plan",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:migrations": "tsx scripts/check-migration-notes.ts",
    "db:seed": "npx tsx src/lib/database/seed.ts",
    "recipes:enrich": "tsx scripts/enrich-recipes.ts",
    "recipes:fetch": "tsx scripts/fetch-themealdb-recipes.ts",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:unit": "vitest run",
    "check": "npm run format:check && npm run check:types && npm run test:unit && npm run check:migrations",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@typescript/native-preview": "npm:typescript@^7.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.102.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "type": "module"
}

DATABASE_URL=...
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=admin

# Required by `docker compose --profile production up -d`.
# Restic supports S3 and other off-host repositories; keep this password safe.
RESTIC_REPOSITORY=s3:s3.example.com/meal-plan-backups
RESTIC_PASSWORD=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-central-1

# File containing the Slack incoming-webhook URL monitored by the operator.
ALERT_WEBHOOK_URL_FILE=./secrets/alert-webhook-url

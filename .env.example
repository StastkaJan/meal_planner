DATABASE_URL=...
LOG_LEVEL=info
DEPLOYMENT_VERSION=dev
GRAFANA_ADMIN_PASSWORD=admin

# Local backup testing only. Production values belong in `.env.production`;
# see `.env.production.example` and `docs/production.md`.
RESTIC_REPOSITORY=s3:s3.example.com/meal-plan-backups
RESTIC_PASSWORD=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-central-1

# File containing the Slack incoming-webhook URL monitored by the operator.
ALERT_WEBHOOK_URL_FILE=./secrets/alert-webhook-url

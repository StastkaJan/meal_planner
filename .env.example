DATABASE_URL=...
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=admin
METRICS_TOKEN=replace-with-a-long-random-token
PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=organization-slug
SENTRY_PROJECT=project-slug
SENTRY_RELEASE=meal-plan@commit-sha
# Build secret: pass SENTRY_AUTH_TOKEN with Docker --secret; never bake it into the image.
